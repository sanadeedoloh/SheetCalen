rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Match configurations document
    match /artifacts/{appId}/public/data/settings/config {
      allow read, write: if isValidId(appId);
    }

    // Match calendar state document
    match /artifacts/{appId}/public/data/live_calendar/state {
      allow read, write: if isValidId(appId);
    }

    // Match device notification subscriptions
    match /artifacts/{appId}/subscriptions/{deviceId} {
      allow get, write: if isValidId(appId) && isValidId(deviceId);
      allow list: if isValidId(appId);
    }

    // Match scheduler state document
    match /artifacts/{appId}/scheduler/state {
      allow read, write: if isValidId(appId);
    }

    // Match alerts
    match /artifacts/{appId}/subscriptions/{deviceId}/alerts/{alertId} {
      allow read, write: if isValidId(appId) && isValidId(deviceId) && isValidId(alertId);
    }
  }
}
